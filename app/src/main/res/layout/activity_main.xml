<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090A11"
    android:orientation="vertical">

    <!-- Main video area: native Media3 player -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true">
        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:use_controller="false" />
    </FrameLayout>

    <!-- Compact NUSA TV app bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#111421"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">
        <ImageView
            android:layout_width="68dp"
            android:layout_height="42dp"
            android:contentDescription="NUSA TV"
            android:scaleType="fitCenter"
            android:src="@drawable/nusa_tv_logo" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <Button
            android:id="@+id/btnFilterIndo"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#252A3A"
            android:minWidth="92dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Indonesia ▼"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnReload"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#252A3A"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="⚙"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:contentDescription="Pengaturan" />
        <Button
            android:id="@+id/btnStop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:backgroundTint="#252A3A"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="■"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:contentDescription="Berhenti" />
        <Button
            android:id="@+id/btnFullscreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:backgroundTint="#252A3A"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="⛶"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:contentDescription="Layar penuh" />
    </LinearLayout>


    <!-- Active source/server selector -->
    <HorizontalScrollView
        android:id="@+id/serverTabsScroll"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#111421"
        android:fillViewport="false"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <LinearLayout
            android:id="@+id/serverTabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/welcomePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111421"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">
        <TextView android:id="@+id/tvLiveLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● LIVE • NUSA TV" android:textColor="#FF435B" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvWelcomeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="Pilih channel" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvWelcomeDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="Sumber: NUSA TV" android:textColor="#9CA2B5" android:textSize="10sp" />
        <Button android:id="@+id/btnRetry" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Coba lagi" android:visibility="gone" />
        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="Memuat daftar channel..." android:textColor="#9CA2B5" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statsBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#090A11"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <TextView android:id="@+id/tvSectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Daftar Channel" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvStats" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 channel" android:textColor="#B99AFB" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#07111F"
        android:padding="16dp"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pengaturan"
            android:textColor="#168DEB"
            android:textSize="23sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />
        <LinearLayout
            android:id="@+id/settingsTabs"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="#0D1A2A" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/settingsOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="18dp" />
        </ScrollView>
        <Button
            android:id="@+id/btnSettingsBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Kembali ke Daftar Channel"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#078DB8" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChannels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#090A11"
        android:clipToPadding="false"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />
</LinearLayout>
