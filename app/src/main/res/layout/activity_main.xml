<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090A11"
    android:orientation="vertical">

    <!-- Wide live player, matching the reference's top-first layout -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true">
        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:use_controller="true"
            />
    </FrameLayout>

    <!-- Main toolbar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#141622"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="14dp">
        <ImageView
            android:layout_width="76dp"
            android:layout_height="44dp"
            android:contentDescription="NUSA TV"
            android:scaleType="fitCenter"
            android:src="@drawable/nusa_tv_logo" />
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="false">
            <LinearLayout
                android:id="@+id/serverTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
        <Button
            android:id="@+id/btnFilterIndo"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="#1762D7"
            android:minWidth="112dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Indonesia ▼"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnReload"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#1762D7"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="＋"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:contentDescription="Muat ulang playlist" />
        <Button
            android:id="@+id/btnStop"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="7dp"
            android:backgroundTint="#E50920"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="⛶"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:contentDescription="Perbesar layar" />
        <Button
            android:id="@+id/btnFullscreen"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#263047"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="⛶"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Search and category shortcuts -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="2dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:background="@drawable/bg_search_nusa"
        android:textColor="#FFFFFF"
        android:textColorHint="#9CA2B5"
        android:hint="⌕  Cari channel TV..."
        android:inputType="text"
        android:singleLine="true" />

    <LinearLayout
        android:id="@+id/welcomePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#141622"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="7dp"
        android:paddingBottom="8dp">
        <TextView android:id="@+id/tvLiveLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● LIVE  •  NUSA TV" android:textColor="#18D7E8" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvWelcomeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="Pilih channel" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvWelcomeDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="Sumber: NUSA TV" android:textColor="#A4A8B8" android:textSize="11sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
            <Button android:id="@+id/btnRetry" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Coba lagi" />
        </LinearLayout>
        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="Memuat daftar channel..." android:textColor="#9CA2B5" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statsBar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="#141622"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">
        <TextView android:id="@+id/tvSectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Daftar Channel" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvStats" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 channel" android:textColor="#19D7E8" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChannels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#090A11"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp" />
</LinearLayout>
