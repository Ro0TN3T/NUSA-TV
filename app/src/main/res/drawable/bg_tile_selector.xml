<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1B3450" />
            <stroke android:width="3dp" android:color="#4DD8D0" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1B3450" />
            <stroke android:width="2dp" android:color="#168BD0" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#101A2B"
                android:startColor="#17253B" />
            <stroke android:width="1dp" android:color="#2A3C58" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
