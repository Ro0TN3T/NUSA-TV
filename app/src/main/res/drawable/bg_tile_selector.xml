<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#211B35" />
            <stroke android:width="1.5dp" android:color="#A88BFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1B2030" />
            <stroke android:width="1dp" android:color="#7770A2" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#121725" />
            <stroke android:width="1dp" android:color="#252C3E" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
